---
// Hero.astro
import { Image } from "astro:assets";
---

<section
	id="hero"
	class="relative w-full h-screen max-h-screen overflow-hidden"
>
	<!-- Background video/image with grayscale effect -->
	<div id="video-background" class="absolute inset-0 w-full h-full">
		<div
			id="image-placeholder"
			class="absolute inset-0 bg-cover bg-center bg-no-repeat z-10 transition-opacity duration-300"
		>
			<Image
				src="/assets/images/hero-background.webp"
				alt="Fondo de Yamaha Motos"
				class="w-full h-full object-cover grayscale"
				width={1920}
				height={1080}
				loading="eager"
				format="webp"
			/>
		</div>
		<div
			id="video-container"
			class="relative w-full h-full overflow-hidden"
		>
			<!-- Blur backdrop for aesthetics -->
			<div
				class="absolute inset-0 backdrop-filter backdrop-blur-sm bg-black/20 z-0"
				aria-hidden="true"
			>
			</div>

			<!-- Video with enhanced styling -->
			<video
				id="background-video"
				class="absolute inset-0 w-full h-full object-cover transform scale-105 filter contrast-105 brightness-50s opacity-0 transition-opacity duration-700 ease-in-out"
				autoplay
				loop
				muted
				playsinline
				preload="metadata"
				poster="/assets/images/hero-background.webp"
				oncanplay="this.classList.remove('opacity-0'); this.classList.add('opacity-90');"
				aria-hidden="true"></video>

			<!-- Optional noise texture overlay -->
			<div
				class="absolute inset-0 bg-noise opacity-5 mix-blend-overlay pointer-events-none z-10"
				aria-hidden="true"
			>
			</div>
		</div>
	</div>

	<!-- Text overlay -->
	<div
		class="relative z-40 h-full flex flex-col justify-end pb-32 px-8 sm:px-16"
	>
		<div class="max-w-2xl">
			<div class="animate-blurred-fade-in flex items-center mb-4">
				<Image
					src="/assets/images/map.svg"
					alt=""
					class="w-5 h-5 mr-2"
					width={20}
					height={20}
					loading="lazy"
				/>
				<span class="text-white text-lg font-bold">
					Comercial Pesqueros Local 3, Puerto Barrios Izabal
				</span>
			</div>
			<h1
				class="animate-bounce-fade-in text-white text-5xl sm:text-6xl md:text-7xl font-extrabold mb-8 leading-tight"
			>
				DOMINA EL AGUA, CONQUISTA LA AVENTURA
			</h1>
			<a
				href="#productos"
				class="animate-fade-in-down inline-flex items-center bg-white text-black
			font-semibold px-6 py-3 rounded-full hover:bg-red-500
			hover:text-white transition-colors duration-300"
			>
				<span class="mr-2">DESCUBRE MÁS</span>
				<svg
					xmlns="http://www.w3.org/2000/svg"
					class="h-5 w-5"
					viewBox="0 0 20 20"
					fill="currentColor"
				>
					<path
						fill-rule="evenodd"
						d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z"
						clip-rule="evenodd"></path>
				</svg>
			</a>
		</div>
	</div>

	<script>
		document.addEventListener("DOMContentLoaded", function () {
			const videoContainer = document.getElementById(
				"video-container",
			) as HTMLDivElement | null;
			const imagePlaceholder = document.getElementById(
				"image-placeholder",
			) as HTMLDivElement | null;
			const video = document.getElementById(
				"background-video",
			) as HTMLVideoElement | null;

			if (video) {
				video.src = "/assets/hero-background.mp4";

				const playVideo = () => {
					video
						.play()
						.then(() => {
							if (videoContainer)
								videoContainer.style.opacity = "1";
							if (imagePlaceholder)
								imagePlaceholder.style.opacity = "0";
						})
						.catch((error) => {
							console.error(
								"Error al reproducir el video:",
								error,
							);
						});
				};

				video.addEventListener("canplay", playVideo, { once: true });

				// Fallback for mobile devices
				["touchstart", "click"].forEach((event) => {
					document.body.addEventListener(event, playVideo, {
						once: true,
					});
				});
			}
		});
	</script>
</section>
